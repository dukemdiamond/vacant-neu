{
  "name": "vacant-neu",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "scrape": "pnpm --filter @vacantneu/scraper scrape",
    "buildings": "pnpm --filter @vacantneu/scraper buildings",
    "test": "vitest run",
    "typecheck": "tsc --build",
    "format": "prettier --write .",
    "inspect": "pnpm --filter @vacantneu/scraper inspect",
    "events": "pnpm --filter @vacantneu/scraper events",
    "demo": "node tools/demo/record.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "playwright": "^1.63.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
